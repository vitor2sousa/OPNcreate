OPNSENSE_URL=#url do seu opnsense EX: https://192.168.10.1
OPNSENSE_API_KEY=#sua key do opnsense(usuário root)
OPNSENSE_API_SECRET=#sua secret do opnsense(usuário root)
OPNSENSE_SSH_HOST=#ip do seu opnsense
OPNSENSE_SSH_USER=#seu usuário root ssh
OPNSENSE_SSH_PASS=#sua senha ssh
OPNSENSE_INTERFACE_PAI=#sua interface opnsense
OPNSENSE_WAN_IP=#seu ip publico